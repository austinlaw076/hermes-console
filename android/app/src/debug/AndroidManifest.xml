<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      Debug network security config.
      Replaces the global usesCleartextTraffic override with an explicit
      network_security_config so the policy is documented and self-contained.
      Allows cleartext HTTP for LAN/Tailscale gateway access in debug builds.
      Release builds have their OWN network_security_config (src/release/res/xml)
      which also permits cleartext for self-hosted LAN/Tailscale gateways,
      mitigated in UX by TransportPrivacy warnings (lib/core/utils/transport_privacy.dart).
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"/>
</manifest>
