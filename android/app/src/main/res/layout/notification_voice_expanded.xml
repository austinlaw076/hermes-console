<?xml version="1.0" encoding="utf-8"?>
<!--
  Cuerpo ancho y redactado de la notificación de voz. Android conserva fuera
  de este layout la cabecera y el icono de la app. Los dos controles reutilizan
  los PendingIntent del servicio dentro de esta vista porque la fila nativa se
  renderiza sin etiquetas en algunos Pixel. No hay transcript, respuesta,
  herramientas ni datos de conexión.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_notification_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/voice_notification_orb"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/voice_notification_orb"
        android:scaleType="fitCenter"
        android:src="@drawable/notification_voice_orb_active" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/voice_notification_state"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/voice_notification_active"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/voice_notification_mic"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/voice_notification_mic_active" />

            <TextView
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="·"
                android:importantForAccessibility="no" />

            <Chronometer
                android:id="@+id/voice_notification_duration"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/voice_notification_duration"
                android:format="%s" />
        </LinearLayout>

        <TextView
            android:id="@+id/voice_notification_open_hint"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/voice_notification_open_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/voice_notification_primary_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/notification_voice_action_background"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/voice_notification_primary_action"
                android:textColor="@color/voice_notification_action_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voice_notification_end_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/notification_voice_action_background"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/voice_notification_end_action"
                android:textColor="@color/voice_notification_action_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
