<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      qaProfile debe ejercer la misma política de transporte que release.
      Android no admite allowlists CIDR para LAN/Tailscale, por lo que la
      plataforma permite cleartext y TransportPrivacy aplica la frontera real:
      solo loopback/red privada; HTTPS obligatorio para hosts públicos.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"/>
</manifest>
